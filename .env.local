# --- Database Connection (Drizzle ORM) ---
# Get your database password from Supabase Dashboard > Settings > Database
# Use connection pooler (port 6543) for better performance
# Format: postgresql://postgres:[PASSWORD]@[PROJECT_REF].supabase.co:6543/postgres?pgbouncer=true
# Or direct connection: postgresql://postgres:[PASSWORD]@[PROJECT_REF].supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:[YOUR_DATABASE_PASSWORD]@eunvonaawdupuqulothd.supabase.co:6543/postgres?pgbouncer=true

# --- AI Providers ---
# DeepSeek API Key (optional)
DEEPSEEK_API_KEY=your_deepseek_key

# OpenAI API Key (optional)
OPENAI_API_KEY=your_openai_key

# --- Redis Configuration ---
# Redis connection URL (defaults to localhost if not set)
REDIS_URL=redis://localhost:6379

# --- Application Configuration ---
PORT=8000
NODE_ENV=development

# --- JWT Secret ---
# JWT secret for token validation (should match Supabase JWT secret)
# You can use the same secret from Supabase project settings
JWT_SECRET=your_supabase_jwt_secret

# --- CORS Configuration (optional) ---
# Comma-separated list of allowed origins
# CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Rate Limiting (optional) ---
# RATE_LIMIT_TTL=60000
# RATE_LIMIT_MAX=100

# --- Logging (optional) ---
# LOG_LEVEL=info
