# ===========================================
# VETLY API ENVIRONMENT CONFIGURATION
# ===========================================
# Copy this file to .env.local for local development
# Copy to .env.staging or .env.production for other environments

# ===========================================
# SUPABASE
# ===========================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key

# ===========================================
# AI PROVIDERS
# ===========================================
DEEPSEEK_API_KEY=your_deepseek_key
OPENAI_API_KEY=your_openai_key
# Optional: for FoodScan + PawScan (Gemini 2.0 Flash). If unset, falls back to OpenAI.
GEMINI_API_KEY=your_gemini_api_key

# ===========================================
# REDIS
# ===========================================
# Local: redis://localhost:6379
# Docker: redis://redis:6379
# DigitalOcean: Use managed Redis URL
REDIS_URL=redis://localhost:6379

# ===========================================
# APPLICATION
# ===========================================
PORT=3000
NODE_ENV=development
LOG_LEVEL=debug

# ===========================================
# SECURITY
# ===========================================
# JWT Secret (same as Supabase JWT secret for token validation)
JWT_SECRET=your_supabase_jwt_secret

# ===========================================
# RATE LIMITING
# ===========================================
RATE_LIMIT_TTL=60000
RATE_LIMIT_MAX=100

# ===========================================
# CORS
# ===========================================
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8081

# ===========================================
# DATABASE (required for API; use Supabase pooler or direct)
# ===========================================
# From Supabase: Project Settings -> Database -> Connection string (URI, use port 6543 for pooler)
# DATABASE_URL=postgresql://postgres.[ref]:[PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres
# Or: SUPABASE_DATABASE_URL=...

# ===========================================
# DIGITALOCEAN APP PLATFORM – required for vetly-api to start
# ===========================================
# These MUST be set or the app crashes on boot:
#   SUPABASE_URL, SUPABASE_SERVICE_KEY, JWT_SECRET, DATABASE_URL (or SUPABASE_DATABASE_URL)
# Use GEMINI_API_KEY (not Gemeni_API_Key). CORS_ORIGINS comma-separated, no trailing comma.
# Redis: set REDIS_URL to a managed Redis URL, or leave unset to disable Redis (app still runs).
# Zoom: optional; set ZOOM_ACCOUNT_ID, ZOOM_CLIENT_ID, ZOOM_CLIENT_SECRET if using telehealth.

# ===========================================
# DOCKER / DEPLOYMENT (Optional)
# ===========================================
# DOCKER_REGISTRY=registry.digitalocean.com/vetly
# IMAGE_TAG=latest
